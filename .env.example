# Gemini AI
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash

# Session security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-random-secret
# Optional: enable browser cookie-based persistent login (less strict than session-only)
ENABLE_PERSISTENT_LOGIN=0

# Auth safety guardrails (optional; defaults shown)
# Login throttle: max 5 failed attempts in 10 minutes, then 15-minute lock.
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900

# Forgot-password throttle: max 3 requests in 30 minutes.
AUTH_RESET_WINDOW_SECONDS=1800
AUTH_RESET_MAX_ATTEMPTS=3

# Gemini API guardrails (optional; defaults shown)
# Rate limit per user/session to reduce abuse/cost spikes.
GEMINI_RATE_WINDOW_SECONDS=60
GEMINI_MAX_REQUESTS_PER_WINDOW=20
# Input/output safety caps used before API calls.
# CV cap: four A4 pages of text packed edge to edge at 10 pt; longer CVs are rejected.
GEMINI_MAX_CV_CHARS=26624
GEMINI_MAX_JD_CHARS=40000
# File-size guardrail. Can only lower the 2 MB upload cap (maxUploadSize, MAX_FILE_MB).
GEMINI_MAX_FILE_SIZE_BYTES=2097152
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=2400

# Google OAuth (optional: enables "Continue with Google")
# 1) Go to https://console.cloud.google.com/apis/credentials
# 2) Create an OAuth 2.0 Client ID (Web application)
# 3) Add http://localhost:8501 to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501

# SMTP email (optional: enables password reset emails)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_sender_email@example.com
SMTP_ENCRYPTION=tls
